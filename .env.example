# Huodongxing CLI & SDK Configuration (Optional)
# Copy to .env for local overrides. Never commit real session cookies.

# Base URL for Huodongxing portal
HDX_BASE_URL=https://www.huodongxing.com

# Execution engine: auto (default) | direct | opencli
HDX_ENGINE=auto

# OpenCLI Browser Bridge session name (default: work)
HDX_BROWSER_SESSION=work

# Minimum interval (ms) between requests to respect OpenResty WAF threshold (8 req / 20s)
HDX_MIN_INTERVAL_MS=900

# Optional Cookie header for headless Direct HTTP mode (e.g. "HDXWAFID=...; AccupassWeb=...")
HDX_COOKIE=
